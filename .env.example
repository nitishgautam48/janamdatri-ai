# Janamdatri-AI · configuration (copied to .env by run_local.sh / run_local.bat; copy it yourself for Docker)
# Never commit .env or share it: it holds your keys and passwords.

ENVIRONMENT=development

# --- Your own secrets (make them up; not from any website) ----------------------------------------------
# JWT_SECRET signs every login token. Anyone who knows it could log in as any user, so on a server use a
# random value of 32+ characters (PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
JWT_SECRET=local-dev-secret-change-me-for-any-shared-use-0123456789
# Admin account for the admin API (POST /api/v1/auth/admin/login)
ADMIN_EMAIL=admin@janamdatri.local
ADMIN_PASSWORD=ChangeMe!2026

# --- Cloud AI keys (free tiers) ---------------------------------------------------------------------------
# Leave any of them empty: the app skips that provider and falls back to the next one, and finally to the
# built-in 230-topic knowledge base. Safety decisions (care level, SOS) never use AI.
GEMINI_API_KEY=                    # aistudio.google.com → Get API key   (answers, search, report photos)
GROQ_API_KEY=                      # console.groq.com → API Keys          (backup answers, voice to text)
# These two are enough for every feature.
# Optional extras
AZURE_SPEECH_KEY=                  # portal.azure.com → Speech (Free F0) → Keys and Endpoint → KEY 1 (natural Hindi voice;
AZURE_SPEECH_REGION=centralindia   #   without it the phone / browser voice reads aloud). The Speech resource's region.
OPENROUTER_API_KEY=                # openrouter.ai/keys        (third backup model)
OCRSPACE_API_KEY=                  # ocr.space/ocrapi          (second cloud OCR engine)
MAPTILER_KEY=                      # cloud.maptiler.com → API keys (free: clearer map pictures; OpenStreetMap is used without it)
ORS_API_KEY=                       # openrouteservice.org → Dashboard → API key (free: reliable road routes and distances)
AZURE_MAPS_KEY=                    # portal.azure.com → Azure Maps account → Authentication → Primary key

# Which models answer: auto = Gemini → Groq → OpenRouter → local Ollama (if running) → knowledge base
LLM_PROVIDER=auto
LLM_CHAIN=gemini,groq,openrouter,ollama
GEMINI_MODEL=gemini-2.5-flash
GEMINI_SECONDARY_MODEL=gemini-2.5-flash-lite   # Talk To Me and the daily tip
GROQ_MODEL=openai/gpt-oss-120b
GROQ_SECONDARY_MODEL=openai/gpt-oss-20b
# GROQ_WHISPER_MODEL=whisper-large-v3   # voice to text; whisper-large-v3-turbo is faster but less accurate in Hindi

# Privacy and free-limit protection
AI_REDACT=true                     # names, phone numbers, pincodes and IDs are removed before text leaves the server
OCR_CLOUD_ENABLED=true             # false = report photos never leave the server (local Tesseract reads them)
AI_DAILY_LIMIT=900                 # cloud AI requests a day; after that the knowledge base answers
STT_DAILY_LIMIT=1500               # voice messages a day sent to cloud speech-to-text
AZURE_STT_MONTHLY_SECONDS=16200    # 4.5 h of Azure speech-to-text a month (free tier: 5 h)
AZURE_TTS_MONTHLY_CHARS=450000     # Azure neural voice characters a month (free tier: 500,000)

# --- Database / cache ---------------------------------------------------------------------------------------
# Local run: a SQLite file (backend/janamdatri.db). Docker uses PostgreSQL + Redis automatically.
# DATABASE_URL=postgresql+psycopg://janamdatri:janamdatri@localhost:5432/janamdatri
# REDIS_URL=redis://localhost:6379/0
POSTGRES_PASSWORD=janamdatri       # Docker database password: change it on a server

# --- SMS ----------------------------------------------------------------------------------------------------
# SMS (OTPs, ASHA alerts, family alerts) are delivered to Mailpit, an inbox at http://localhost:8025
SMS_CHANNEL=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_URL=http://localhost:8025
OTP_DEV_ECHO=false
ASHA_MOCK_REGISTRY=true            # accept well-formed new ASHA IDs not in the starter registry

# Starter reference data: facilities, villages and ASHA workers around Bareilly (UP)
SEED_REFERENCE_DATA=true

# --- Maps ---------------------------------------------------------------------------------------------------
# OpenStreetMap for places and real hospitals anywhere in India; road distances and routes from Azure Maps
# (if AZURE_MAPS_KEY is set) or the free OSRM router. Needs internet; without it the bundled data is used.
OSM_ENABLED=true
ROUTING_PROVIDER=auto              # auto = Azure Maps → openrouteservice → OSRM, by which keys are set | off
# Map pictures: the server fetches them once (OpenStreetMap, then backups), keeps a copy in media/tiles and serves
# them to the app (keys never reach the browser). Order: maptiler (if key), osm (openstreetmap.org), osmfr, esri.
MAP_TILE_SOURCES=maptiler,osm,osmfr,esri   # maptiler only when MAPTILER_KEY is set

# --- Public server only (docker-compose.prod.yml) ---------------------------------------------------------
# DOMAIN=janamdatri.centralindia.cloudapp.azure.com
# MAILPIT_UI_AUTH=nitish:a-strong-password      # login for the SMS inbox at https://DOMAIN/mailpit/

# --- Optional local models (docker-compose.local-ai.yml or run_local --with-ai) ----------------------------
# LLM_MODEL=llama3.1:8b
# LLM_SECONDARY_MODEL=gemma2:9b
# EMBEDDING_OLLAMA_MODEL=nomic-embed-text
# WHISPER_MODEL=base
# COQUI_TOS_AGREED=1               # XTTS v2 Hindi voice: Coqui Public Model License (non-commercial use)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
