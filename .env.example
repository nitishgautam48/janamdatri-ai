# Janamdatri-AI · local configuration (copied to .env by run_local.sh / run_local.bat)

ENVIRONMENT=development
JWT_SECRET=local-dev-secret-change-me-for-any-shared-use-0123456789
ADMIN_EMAIL=admin@janamdatri.local
ADMIN_PASSWORD=ChangeMe!2026

# Database: a SQLite file (backend/janamdatri.db) by default. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg://janamdatri:janamdatri@localhost:5432/janamdatri
# Redis is optional; without it OTPs and rate limits are kept in memory.
# REDIS_URL=redis://localhost:6379/0

# SMS (OTPs, ASHA alerts, family alerts) are delivered to Mailpit, a local inbox:
#   http://localhost:8025   (run_local starts it; nothing leaves this computer)
SMS_CHANNEL=mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
MAILPIT_UI_URL=http://localhost:8025
OTP_DEV_ECHO=false
ASHA_MOCK_REGISTRY=true            # accept well-formed new ASHA IDs not in the starter registry

# Starter reference data: facilities, villages and ASHA workers around Bareilly (UP)
SEED_REFERENCE_DATA=true

# Local AI models through Ollama (https://ollama.com). Each one is optional and falls back cleanly;
# if Ollama isn't running, answers come from the built-in knowledge base.
#   main model:       Health Assistant, report explanations, knowledge answers
#   second model:     Talk To Me and the daily tip (and backup for the main model). Leave empty to disable.
#   embedding model:  smarter knowledge search (combined with keyword search)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b              # e.g. gemma3:12b, gemma3:4b
LLM_SECONDARY_MODEL=gemma2:9b
LLM_SECONDARY_TASKS=emotional,tip
EMBEDDING_PROVIDER=auto            # hybrid when the embedding model below is pulled
EMBEDDING_OLLAMA_MODEL=nomic-embed-text
LLM_TIMEOUT_SECONDS=90

# Speech to text (Whisper), text to speech (Coqui TTS) and OCR (PaddleOCR + Tesseract) are used when
# installed (Docker installs them; run_local with WITH_AI=1 / --with-ai)
WHISPER_PROVIDER=auto
WHISPER_MODEL=base                 # small / medium / large-v3 are more accurate but slower on CPU
WHISPER_COMPUTE_TYPE=int8
TTS_PROVIDER=auto                  # off = use the phone / browser voice
COQUI_TOS_AGREED=1                 # XTTS v2 Hindi voice: Coqui Public Model License (non-commercial use)
OCR_PROVIDER=auto
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# Maps: OpenStreetMap for places and real hospitals anywhere in India (needs internet).
OSM_ENABLED=true
